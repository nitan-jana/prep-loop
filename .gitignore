# Everything personal. Profile, claims, logs, plans, scores, stories, the
# resume dropped in for onboarding, the denylist. One line, so there is no
# version of this repo in which any of it is tracked.
#
# The line is the privacy model. Nothing else in here is load-bearing.
instance/

# Per-machine tool permissions. Everything else under .claude/ is committed
# deliberately so a fresh clone works with no setup.
.claude/settings.local.json

# Bun. There are no dependencies today; this is here so that adding one
# later cannot accidentally commit a tree.
node_modules/

# OS noise
.DS_Store
Thumbs.db
