#!/bin/sh
# Runs the full check before a commit lands.
#
# Install once per clone, or let `bun install` do it:
#
#   bun run hooks
#
# Hooks live outside the tracked tree by default, which is why this needs a
# config line rather than arriving with the clone.
#
# CI runs the same command and is the gate for most of it. Denylist terms are
# the exception, and the reason this hook is not merely a convenience: the
# denylist is ignored by git, so it never reaches a runner, and term and canary
# matching are off in CI by construction. For that tier this hook is the only
# check that exists.
#
# It runs in well under a second. A slow hook is a hook that gets bypassed.

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found, skipping checks" >&2
  exit 0
fi

exec bun run check
